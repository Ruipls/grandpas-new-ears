.page {
  min-height: 100%;
  box-sizing: border-box;
  padding-top: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 28rpx;
  padding-left: 28rpx;
  background: #eef4f2;
  color: #17201d;
}

.contrast-high {
  background: #000000;
  color: #ffffff;
}

.intro,
.empty {
  display: block;
  font-size: 34rpx;
  line-height: 1.45;
}

.empty {
  margin-top: 48rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.meta {
  display: block;
  color: #3d4f49;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.body {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-word;
}

.delete,
.clear {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #ffffff;
  color: #9f1239;
  border: 2rpx solid #9f1239;
}

.delete {
  width: 220rpx;
  margin-top: 18rpx;
}

.clear {
  width: 100%;
  margin-top: 28rpx;
  margin-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  margin-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.pressed {
  opacity: 0.82;
}

button[disabled] {
  opacity: 0.45;
}

.contrast-high .intro,
.contrast-high .meta {
  color: #f4f4f4;
}

.contrast-high .card,
.contrast-high .delete,
.contrast-high .clear {
  background: #000000;
  color: #ffe14a;
  border-color: #ffe14a;
}
