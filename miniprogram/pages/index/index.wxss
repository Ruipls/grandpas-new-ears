.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #eef4f2;
  color: #17201d;
  box-sizing: border-box;
}

.contrast-high {
  background: #000000;
  color: #ffffff;
}

.status-bar {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 28rpx 12rpx;
}

.status-pill {
  min-height: 72rpx;
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  gap: 14rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #52635d;
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.status-label {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
}

.status-detail {
  color: #3d4f49;
  font-size: 32rpx;
  line-height: 1.4;
}

.state-listening {
  background: #e5f4ef;
  color: #135246;
}

.state-paused {
  color: #9a3412;
}

.state-error {
  color: #9f1239;
}

.state-listening .status-dot {
  animation: listen-pulse 1.6s ease-in-out infinite;
}

@keyframes listen-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

.caption-stage {
  flex: 1 1 auto;
  height: 0;
  min-height: 180rpx;
  background: rgba(255, 255, 255, 0.72);
}

.empty {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16rpx;
  padding: 48rpx 36rpx;
}

.empty-title {
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.15;
}

.empty-hint {
  color: #3d4f49;
  font-size: 36rpx;
  line-height: 1.45;
}

.segment {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 32rpx 8rpx;
}

.segment-meta {
  color: #52635d;
  font-size: 28rpx;
  font-weight: 700;
}

.segment-text {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.28;
  word-break: break-word;
}

.font-xlarge .segment-text,
.font-xlarge .partial-text {
  font-size: 84rpx;
}

.font-huge .segment-text,
.font-huge .partial-text {
  font-size: 112rpx;
}

.partial {
  margin: 24rpx 28rpx 12rpx;
  padding: 20rpx 24rpx;
  border-left: 10rpx solid #1f6f62;
  background: #e5f4ef;
  color: #135246;
}

.partial-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.partial-text {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.3;
  word-break: break-word;
}

.caption-end {
  height: 12rpx;
}

.dock {
  flex: 0 0 auto;
  padding: 16rpx 24rpx 8rpx;
  background: #fbfcfb;
}

.primary-controls {
  display: flex;
  gap: 16rpx;
}

.main-action,
.side-action,
.choice,
.text-action,
.help-action {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.main-action {
  flex: 1 1 auto;
  background: #1f6f62;
  color: #ffffff;
  font-size: 48rpx;
}

.side-action {
  flex: 0 0 160rpx;
  background: #ffffff;
  color: #17201d;
  border: 2rpx solid #c9d7d1;
}

.settings {
  flex: 0 1 auto;
  max-height: 42%;
  overflow-y: auto;
  padding-top: 8rpx;
  padding-right: 24rpx;
  padding-bottom: 20rpx;
  padding-left: 24rpx;
  background: #fbfcfb;
}

.setting-block {
  margin-top: 12rpx;
}

.setting-label {
  display: block;
  margin-bottom: 10rpx;
  color: #3d4f49;
  font-size: 30rpx;
  font-weight: 700;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice {
  min-width: 144rpx;
  padding: 0 20rpx;
  background: #ffffff;
  color: #17201d;
  border: 2rpx solid #c9d7d1;
  font-size: 34rpx;
}

.choice-on {
  background: #1f6f62;
  color: #ffffff;
  border-color: #1f6f62;
}

.text-action,
.help-action {
  width: 100%;
  margin-top: 16rpx;
  background: #ffffff;
  color: #17201d;
  border: 2rpx solid #c9d7d1;
  font-size: 36rpx;
}

.help-action {
  background: #fff4e5;
  border-color: #9a3412;
  color: #9a3412;
}

.privacy-note {
  display: block;
  margin: 16rpx 0 8rpx;
  padding-bottom: calc(12rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  color: #3d4f49;
  font-size: 30rpx;
  line-height: 1.45;
}

.pressed {
  opacity: 0.82;
}

button[disabled] {
  opacity: 0.45;
}

.contrast-high .status-pill {
  background: #111111;
  color: #ffffff;
}

.contrast-high .status-detail,
.contrast-high .empty-hint,
.contrast-high .segment-meta,
.contrast-high .setting-label,
.contrast-high .privacy-note {
  color: #f4f4f4;
}

.contrast-high .state-listening,
.contrast-high .state-paused {
  background: #111111;
  color: #ffe14a;
}

.contrast-high .state-error {
  background: #111111;
  color: #ffb4b4;
}

.contrast-high .caption-stage,
.contrast-high .dock,
.contrast-high .settings {
  background: #000000;
}

.contrast-high .partial {
  background: #161616;
  color: #ffe14a;
  border-left-color: #ffe14a;
}

.contrast-high .side-action,
.contrast-high .choice,
.contrast-high .text-action {
  background: #000000;
  color: #ffffff;
  border-color: #ffffff;
}

.contrast-high .main-action,
.contrast-high .choice-on {
  background: #ffe14a;
  color: #111111;
  border-color: #ffe14a;
}

.contrast-high .help-action {
  background: #ffe14a;
  color: #111111;
  border-color: #ffe14a;
}
